# Copy to .env and change. Never commit .env.
# Admin key: only for you (list/remove cameras). Users never need it.
WIIA_API_KEY=replace-with-a-long-random-string
# Invite code: give it to friends so they can set up THEIR camera (it shows no records).
WIIA_INVITE_CODE=choose-an-invite-code
# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-gemini-api-key-here
# Only for running Docker on a laptop at home so phones on the same Wi-Fi can connect:
# WIIA_BIND=0.0.0.0
